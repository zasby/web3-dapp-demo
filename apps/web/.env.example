# Reown (WalletConnect) Cloud project id: https://dashboard.reown.com
# Without it only browser-extension wallets (MetaMask, Rabby, …) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Recommended: private Sepolia RPC (Alchemy, Infura, …). Public RPCs are used as a fallback.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Dev only: adds a read-only "Mock wallet (dev)" to the connect modal that pretends to own this address.
NEXT_PUBLIC_MOCK_WALLET_ADDRESS=

# Dev only: `true` adds the local anvil chain (run `pnpm chain`) to the network list.
NEXT_PUBLIC_LOCAL_CHAIN=
