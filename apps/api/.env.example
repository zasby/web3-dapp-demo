# Port of the API. The web app proxies /api/* here (API_URL in apps/web).
PORT=4000

# Origin of the web app. Its host is the only SIWE domain the API accepts, and it may send
# state-changing requests with the session cookie.
WEB_ORIGIN=http://localhost:3000

# Optional private Sepolia RPC, used to verify smart-wallet (ERC-1271) signatures.
SEPOLIA_RPC_URL=
