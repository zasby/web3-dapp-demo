{
  "name": "web3-dapp-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "chain": "anvil --block-time 2 --auto-impersonate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter web e2e",
    "check:scope": "node scripts/scope-check.mjs",
    "check": "pnpm --filter web typecheck && pnpm --filter web lint && pnpm --filter web test && pnpm check:scope"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1"
  }
}
